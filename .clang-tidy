# YAML file but we omit the .yml suffix. Clang convention.

# Disable default checks, manually enable ones we want.
#  - misc-include-cleaner: For detecting missing #includes, esp. for stdlib headers that may still get transitively included by some compilers
#  - All mpi- checks: Buffer derefencing errors and dtype vs pointer type mismatch.
Checks: >
  -*,
  mpi-*,
  misc-include-cleaner

CheckOptions:
  misc-include-cleaner.UnusedIncludes: false
  # Include-What-You-Use check (IWYU). We want to catch missing stdlib include in particular
  misc-include-cleaner.MissingIncludes: true
  # IWYU ignore list for libraries for which IWYU export pragmas are not enough.
  # Eg. CPython and HIP both provide symbols through internal headers, instead of eg. Python.h directly
  # and don't have their own IWYU pragmas in place. Therefore, ignore them. https://github.com/python/cpython/issues/137744.
  # We also allow transitive includes of our own symbols (convenience), hence the .*/c/.* ignore.
  # NB! The pythonX.YY/* ignore may not do the job on all platforms
  misc-include-cleaner.IgnoreHeaders:
    '.*/c/.*;.*/pybind11/.*;.*Python\.h*;.*/python[0-9]\.[0-9]+/.*;
    .*/hip/amd_detail/.*;.*/hip/nvidia_detail/.*'
